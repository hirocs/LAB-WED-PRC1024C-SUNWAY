      "Toll: RM  4.25\n",
      "Remaining: RM 45.75\n"
     ]
    }
   ],
   "source": [
    "# Scenario 1 — TnG eWallet receipt\n",
    "# Combine: input() → float() → arithmetic → f-string output.\n",
