   "source": [
    "# mamak_split.py\n",
    "import math \n",
    "\n",
    "bill = float(input(\"Bill amount (RM): \"))\n",
    "tip_pct = float(input(\"Tip percent (%):  \"))\n",
    "people = int(input(\"Number of people: \"))\n",
    "\n",
    "if people == 0:\n",
    "    print(\"Cannot split between 0 people - try again.\")\n",
    "else:\n",
    "    tip = bill * tip_pct / 100\n",
    "    total = bill + tip\n",
    "    per_person = total / people\n",
    "    per_person = math.ceil(round(per_person * 100, 6)) / 100 \n",
    "\n",
    "    tip_label = f\"Tip ({tip_pct:g}%):\"\n",
    "    people_label = f\"Per person ({people}):\"   \n",
    "\n",
    "print()\n",
    "print(\"--- Mamak split ---\")\n",
    "print(f\"{'Bill':<17}RM {bill:>5.2f}\")\n",
    "print(f\"{tip_label:<17}RM {tip:>5.2f}\")\n",
    "print(f\"{'Grand total:':<17}RM {total:>5.2f}\")\n",
    "print(f\"{people_label:<17}RM {per_person:>5.2f}\")\n"
